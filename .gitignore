config.env
/SPIS_dataset
/pdf
__pycache__
.venv/
/sample_data
arialuni.ttf
/reports

# cmpeeg build output (generated by ProfusionEEGSDK/PythonSDK/cmpeeg/cmpeeg/cmpeeg.sln)
ProfusionEEGSDK/PythonSDK/cmpeeg/cmpeeg/x64/
ProfusionEEGSDK/PythonSDK/cmpeeg/cmpeeg/cmpeeg/x64/

# junction tree used as PYTHON312_64_ROOT when rebuilding cmpeeg
/.py312root

# U-Sleep checkpoints: MIT-licensed via SLEEPYLAND, but trained on NSRR data
# whose Data Use Agreement has not been reviewed for redistribution. Kept local.
/models/usleep

# ProfusionEEG SDK: Compumedics proprietary source, COM DLLs and demo studies
# (which carry a patient record). Located by path or CMPEEG_PYD_DIR at runtime,
# so it does not need to be in the repository.
/ProfusionEEGSDK

# Reference paper, redistributed under CC BY-NC-ND by its publisher
/*.pdf

# Compumedics proprietary source. The spike/seizure detector and the event
# detection library are cleared product code, not part of this project - it
# reads their output from a study and never contains them.
/ProfusionEEG-trunk-*/

# The Claude Design source and its Compumedics design system. The design system
# is built from the controlled brand document (AH790, Proprietary & Confidential)
# and is brand-controlled material, so it stays out of a repository on a personal
# account for the same reason the SDK does. webui/ carries the ported result.
/Dark theme and first pass screens/
/Dark theme and first pass screens.zip

# ProfusionEEG's resource script. Compumedics product source, kept out for the
# same reason as the SDK. eventtypes.py carries the small derived table this
# project needs - the event-type numbers and their display strings - so the .rc
# itself is only required to regenerate it.
/ProFusionEEG.rc
